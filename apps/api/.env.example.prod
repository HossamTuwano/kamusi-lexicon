# PRODUCTION ENVIRONMENT TEMPLATE - kamusi-lexicon API

DO NOT COMMIT THIS FILE TO GIT. Copy this to `.env` on your production server.

# --- Database ---
# Use a managed Postgres 15 instance or a secured container
DB_HOST=your-prod-db-host
DB_PORT=5432
DB_USER=prod_user_name
DB_PASSWORD=your-generated-strong-password
DB_NAME=kamusi_prod

# CRITICAL: Must be 'false' in production to prevent accidental schema wipes.
# Schema updates must be handled via migrations.
DB_SYNC=false

# --- Auth ---
# Generate a 32-byte hex string: openssl rand -hex 32
JWT_SECRET=your-generated-strong-secret

# --- Admin ---
# Used by the users.seed.ts script to set the initial admin password.
# If not provided, a random password will be generated and printed to the console.
ADMIN_PASSWORD=your-strong-admin-password

# --- Redis ---
REDIS_HOST=your-prod-redis-host
REDIS_PORT=6379

# --- App Config ---
NODE_ENV=production
PORT=3001

# Comma-separated list of allowed origins (e.g., https://kamusi.sw, https://admin.kamusi.sw)
CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com
