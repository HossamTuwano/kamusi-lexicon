# Template for apps/api/.env.test (git-ignored).
# Copy to .env.test and fill in values for your local test database.
#
#   cp apps/api/.env.test.example apps/api/.env.test
#
# The e2e suite truncates every table it touches, so point this at a
# throwaway database - never at development or production data.

DB_HOST=localhost
DB_PORT=5432
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_NAME=kamusi_test
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=test-secret-key
DB_SYNC=true
DB_MIGRATIONS_RUN=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
